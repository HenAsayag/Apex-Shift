{
  "name": "apex-shift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/start.js",
    "test:ghosts": "node tests/browser-ghosts.mjs",
    "test:mobile": "node tests/browser-mobile.mjs",
    "dev": "vite --host 0.0.0.0 --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview --host 0.0.0.0 --configLoader native",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src tests index.html vite.config.js README.md",
    "format:check": "prettier --check src tests index.html vite.config.js README.md",
    "test:browser": "node tests/browser-flows.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.6",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
